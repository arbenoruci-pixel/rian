name: One-time fix transport phone corruption

on:
  push:
    branches: [main]
    paths:
      - .github/workflows/one-time-fix-transport-phone-corruption.yml

permissions:
  contents: write

jobs:
  fix:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Apply and validate strict phone fix
        shell: bash
        run: |
          python3 - <<'PY'
          from pathlib import Path
          import re

          p = Path('lib/transport/phone.js')
          s = p.read_text()
          s, n = re.subn(
            r"export function isValidTransportPhoneDigits\(value\) \{\s*return normalizeTransportPhoneKey\(value\)\.length >= 8;\s*\}",
            """export function isValidTransportPhoneDigits(value) {
  const identity = parseTransportPhoneIdentity(value);
  if (!identity.localDigits) return false;
  if (identity.countryCode === '383') return identity.localDigits.length === 8;
  return identity.localDigits.length >= 7 && identity.localDigits.length <= 12;
}

export function canonicalizeTransportPhoneForDial(value) {
  const identity = parseTransportPhoneIdentity(value);
  if (!isValidTransportPhoneDigits(value)) return '';
  return identity.canonicalDigits || '';
}""",
            s,
            count=1,
          )
          if n != 1: raise SystemExit(f'phone validator replacements={n}')
          p.write_text(s)

          p = Path('app/transport/item/page.jsx')
          s = p.read_text()
          s = s.replace('import { buildSmsLink, normalizePhoneForWhatsApp } from "@/lib/smartSms";', 'import { buildSmsLink } from "@/lib/smartSms";\nimport { canonicalizeTransportPhoneForDial } from "@/lib/transport/phone";', 1)
          pattern = re.compile(r"function getPhone\(row\) \{.*?\n\}", re.S)
          replacement = """function getPhone(row) {
  const candidates = [
    row?.client_phone,
    row?.phone,
    row?.telefoni,
    row?.data?.client_phone,
    row?.data?.client?.phone,
    row?.data?.phone,
  ];
  for (const candidate of candidates) {
    const canonical = canonicalizeTransportPhoneForDial(candidate);
    if (canonical) return canonical;
  }
  return '';
}"""
          s, n = pattern.subn(replacement, s, count=1)
          if n != 1: raise SystemExit(f'item getPhone replacements={n}')
          p.write_text(s)

          p = Path('lib/transport/board/shared.js')
          s = p.read_text()
          s = s.replace("import { normalizePhoneForWhatsApp, canonicalizePhone } from '../../smartSms';", "import { canonicalizeTransportPhoneForDial } from '../phone';", 1)
          pattern = re.compile(r"export function getPhone\(item\) \{.*?\n\}", re.S)
          replacement = """export function getPhone(item) {
  const candidates = [
    item?.client_phone,
    item?.data?.client_phone,
    item?.data?.client?.phone,
    item?.data?.phone,
    item?.phone,
  ];
  for (const candidate of candidates) {
    const canonical = canonicalizeTransportPhoneForDial(candidate);
    if (canonical) return canonical;
  }
  return '';
}"""
          s, n = pattern.subn(replacement, s, count=1)
          if n != 1: raise SystemExit(f'shared getPhone replacements={n}')
          s = s.replace("if (ph) window.open(`tel:${canonicalizePhone(ph)}`, '_self');", "if (ph) window.open(`tel:+${ph}`, '_self');", 1)
          p.write_text(s)

          p = Path('lib/appEpoch.js')
          p.write_text(re.sub(r"export const APP_VERSION = '[^']+';", "export const APP_VERSION = '2.0.65-transport-phone-strict-v1';", p.read_text(), count=1))
          p = Path('package.json')
          p.write_text(re.sub(r'"version": "[^"]+"', '"version": "2.0.65-transport-phone-strict-v1"', p.read_text(), count=1))
          p = Path('vite.config.js')
          s = p.read_text()
          s = re.sub(r"sw-navigation-diag\.js\?v=\d+", "sw-navigation-diag.js?v=3505", s, count=1)
          p.write_text(s)
          PY
          npm run build
          rm -f .github/workflows/one-time-analyze-transport-phone.yml .tmp-transport-phone-analysis.txt
          rm .github/workflows/one-time-fix-transport-phone-corruption.yml
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          git commit -m "fix corrupted transport phone dialing"
          git push origin HEAD:main
